generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES_USER
}

enum EnquiryStatus {
  NEW
  QUOTED
  WON
  LOST
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

enum SalesOrderStatus {
  PENDING
  CONFIRMED
  DISPATCHED
  CANCELLED
}

model User {
  id                  Int          @id @default(autoincrement())
  email               String       @unique
  passwordHash        String
  name                String
  role                Role         @default(SALES_USER)
  createdAt           DateTime     @default(now())
  createdCustomers    Customer[]   @relation("CustomerCreator")
  createdEnquiries    Enquiry[]    @relation("EnquiryCreator")
  createdQuotations   Quotation[]  @relation("QuotationCreator")
  createdSalesOrders  SalesOrder[] @relation("SalesOrderCreator")
  processedDispatches Dispatch[]   @relation("DispatchProcessor")
  auditLogs           AuditLog[]

  @@map("users")
}

model Customer {
  id            Int          @id @default(autoincrement())
  companyName   String
  contactPerson String
  mobile        String
  email         String?
  city          String?
  createdById   Int
  createdBy     User         @relation("CustomerCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime     @default(now())
  enquiries     Enquiry[]
  quotations    Quotation[]
  salesOrders   SalesOrder[]

  @@index([createdById])
  @@map("customers")
}

model Enquiry {
  id            Int           @id @default(autoincrement())
  enquiryNumber String        @unique
  customerId    Int
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  enquiryDate   DateTime      @default(now())
  requiredDate  DateTime?
  notes         String?
  status        EnquiryStatus @default(NEW)
  createdById   Int
  createdBy     User          @relation("EnquiryCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime      @default(now())
  items         EnquiryItem[]
  quotation     Quotation?

  @@index([customerId])
  @@index([status])
  @@map("enquiries")
}

model EnquiryItem {
  enquiryId Int
  enquiry   Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int

  @@id([enquiryId, productId])
  @@map("enquiry_items")
}

model Product {
  id              Int              @id @default(autoincrement())
  code            String           @unique
  name            String
  category        String
  unit            String
  basePrice       Decimal          @db.Decimal(12, 2)
  createdAt       DateTime         @default(now())
  inventory       Inventory?
  enquiryItems    EnquiryItem[]
  quotationItems  QuotationItem[]
  salesOrderItems SalesOrderItem[]
  dispatchItems   DispatchItem[]

  @@map("products")
}

model Inventory {
  id          Int     @id @default(autoincrement())
  productId   Int     @unique
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  physicalQty Int     @default(0)
  reservedQty Int     @default(0)

  @@index([productId])
  @@map("inventory")
}

model Quotation {
  id              Int             @id @default(autoincrement())
  quotationNumber String          @unique
  enquiryId       Int             @unique
  enquiry         Enquiry         @relation(fields: [enquiryId], references: [id], onDelete: Restrict)
  customerId      Int
  customer        Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  discountPct     Decimal         @default(0) @db.Decimal(5, 2)
  gstPct          Decimal         @default(18) @db.Decimal(5, 2)
  grandTotal      Decimal         @db.Decimal(12, 2)
  validUntil      DateTime?
  status          QuotationStatus @default(DRAFT)
  createdById     Int
  createdBy       User            @relation("QuotationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime        @default(now())
  items           QuotationItem[]
  salesOrder      SalesOrder?
  auditLogs       AuditLog[]

  @@index([customerId])
  @@index([status])
  @@map("quotations")
}

model QuotationItem {
  quotationId Int
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  qty         Int
  unitPrice   Decimal   @db.Decimal(12, 2)
  lineAmount  Decimal   @db.Decimal(12, 2)

  @@id([quotationId, productId])
  @@map("quotation_items")
}

model SalesOrder {
  id          Int              @id @default(autoincrement())
  orderNumber String           @unique
  quotationId Int              @unique
  quotation   Quotation        @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  customerId  Int
  customer    Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  orderDate   DateTime         @default(now())
  discountPct Decimal          @default(0) @db.Decimal(5, 2)
  gstPct      Decimal          @default(18) @db.Decimal(5, 2)
  totalAmount Decimal          @db.Decimal(12, 2)
  status      SalesOrderStatus @default(PENDING)
  createdById Int
  createdBy   User             @relation("SalesOrderCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime         @default(now())
  items       SalesOrderItem[]
  dispatches  Dispatch[]

  @@index([customerId])
  @@index([status])
  @@map("sales_orders")
}

model SalesOrderItem {
  salesOrderId Int
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId    Int
  product      Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  qty          Int
  unitPrice    Decimal    @db.Decimal(12, 2)
  lineAmount   Decimal    @db.Decimal(12, 2)

  @@id([salesOrderId, productId])
  @@map("sales_order_items")
}

model Dispatch {
  id             Int            @id @default(autoincrement())
  dispatchNumber String         @unique
  salesOrderId   Int            @unique
  salesOrder     SalesOrder     @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  dispatchDate   DateTime       @default(now())
  vehicleNo      String
  driver         String?
  processedById  Int
  processedBy    User           @relation("DispatchProcessor", fields: [processedById], references: [id], onDelete: Restrict)
  createdAt      DateTime       @default(now())
  items          DispatchItem[]
  auditLogs      AuditLog[]

  @@map("dispatches")
}

model DispatchItem {
  dispatchId Int
  dispatch   Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  productId  Int
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  qty        Int

  @@id([dispatchId, productId])
  @@map("dispatch_items")
}

model AuditLog {
  id          Int        @id @default(autoincrement())
  actorId     Int
  actor       User       @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action      String
  entity      String
  entityId    Int
  before      Json?
  after       Json?
  createdAt   DateTime   @default(now())
  quotationId Int?
  quotation   Quotation? @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  dispatchId  Int?
  dispatch    Dispatch?  @relation(fields: [dispatchId], references: [id], onDelete: Cascade)

  @@index([entity, entityId])
  @@map("audit_logs")
}
